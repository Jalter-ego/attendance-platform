# {{ ansible_managed }} — generado en el primer arranque; contiene secretos (0640 root:attendance)
NODE_ENV=production
PORT={{ backend_port }}
CORS_ORIGIN=*
INSTITUTION_TIMEZONE={{ timezone }}

TENANT_ID={{ tenant_id }}
TENANT_ENV={{ env }}
TENANT_PLAN={{ plan }}
INSTITUTION_NAME="{{ institution_name | regex_replace('["\$`]', '') }}"
{% for key, value in (limits | default({})).items() %}
PLAN_{{ key | upper }}={{ value }}
{% endfor %}

# BD propia del tenant, en su VM privada (sin SSL dentro de la VPC).
DB_SSL=false
DB_READ_HOST={{ db_host }}
DB_READ_PORT={{ db_port }}
DB_READ_USERNAME={{ db_user }}
DB_READ_PASSWORD={{ db_password }}
DB_READ_NAME={{ db_name }}
DB_WRITE_HOST={{ db_host }}
DB_WRITE_PORT={{ db_port }}
DB_WRITE_USERNAME={{ db_user }}
DB_WRITE_PASSWORD={{ db_password }}
DB_WRITE_NAME={{ db_name }}

JWT_SECRET={{ jwt_secret }}
JWT_EXPIRES_IN=8h
