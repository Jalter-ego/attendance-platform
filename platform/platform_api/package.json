{
  "name": "attendance-platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker:dev": "node --watch --env-file-if-exists=.env src/worker/index.js",
    "worker": "node --env-file-if-exists=.env src/worker/index.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test tests/*.test.js",
    "test:e2e:local": "node --env-file-if-exists=.env tests/local.e2e.js",
    "test:integration": "node --test tests/create.integration.js",
    "test:runner": "node --test tests/command-runner.test.js tests/redact.test.js",
    "test:backups": "node --test tests/backups.test.js",
    "test:engines": "node --test tests/engines.test.js",
    "test:plans": "node --test tests/plans.test.js",
    "test:cloudformation": "node --test tests/cloudformation.test.js",
    "test:pulumi": "node --test tests/pulumi.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1168.0",
    "@aws-sdk/client-ec2": "3.1168.0",
    "@aws-sdk/client-ssm": "3.1168.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
