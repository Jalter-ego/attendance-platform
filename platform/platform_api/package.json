{
  "name": "attendance-platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker:dev": "node --watch --env-file-if-exists=.env src/worker/index.js",
    "worker": "node --env-file-if-exists=.env src/worker/index.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test tests/unit.test.js",
    "test:backups": "node --test tests/backups.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": { "supertest": "^7.1.4" }
}
