HOST=127.0.0.1
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Base NUEVA de la plataforma; no usar la BD de attendance_core ni de un tenant.
DATABASE_URL=postgresql://attendance:attendance_local@127.0.0.1:5433/attendance_platform
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Para Supabase: certs/supabase-prod-ca-2021.crt. Dejar vacío para PostgreSQL local.
DB_SSL_CA_FILE=

SESSION_HOURS=8
COOKIE_SECURE=false
WORKER_POLL_MS=1000
WORKER_STALE_MS=60000

# Solo para pnpm admin:create. Completar la contraseña antes de ejecutarlo.
BOOTSTRAP_ADMIN_NAME=Administrador de plataforma
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Motores IaC (P2). El worker ejecuta terraform/tofu con las credenciales AWS del proceso
# (AWS_PROFILE o variables AWS_*). Sin IAC_STATE_BUCKET las operaciones de infraestructura
# fallan con un mensaje claro; el resto de la plataforma funciona igual.
IAC_STATE_BUCKET=
# Por defecto se usan estas rutas del repo. Si las cambias, usa rutas absolutas.
# IAC_BASE_OUTPUTS=.local/base.outputs.json
# IAC_AMI_IDS=infra/packer/ami-ids.json
# IAC_RUNS_DIR=.local/runs
IAC_TIMEOUT_S=3600
HEALTH_TIMEOUT_S=900
# CloudFormation: intervalo de consulta de eventos del stack (ms).
CFN_POLL_MS=10000
TERRAFORM_BIN=terraform
TOFU_BIN=tofu
# En Windows suele ser "python"; en Linux/macOS "python3". Solo se usa para la vista previa.
# PYTHON_BIN=python
