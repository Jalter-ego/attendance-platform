HOST=127.0.0.1
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Base NUEVA de la plataforma; no usar la BD de attendance_core ni de un tenant.
DATABASE_URL=postgresql://attendance:attendance_local@127.0.0.1:5433/attendance_platform
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Para Supabase: certs/supabase-prod-ca-2021.crt. Dejar vacío para PostgreSQL local.
DB_SSL_CA_FILE=

SESSION_HOURS=8
COOKIE_SECURE=false
WORKER_POLL_MS=1000
WORKER_STALE_MS=60000

# El modo local simula el ciclo completo y no invoca AWS.
# Usa una base PostgreSQL separada por modo.
PLATFORM_DEPLOY_MODE=local
# Opcional para servir el panel compilado con pnpm build desde platform_web/:
# PLATFORM_WEB_DIST=../platform_web/dist
# CLIENT_ORIGIN debe corresponder a la URL con la que abres el panel.
# Integración real (solo con configuración de AWS del equipo):
# PLATFORM_BASE_OUTPUT_FILE=/ruta/integration.json
# PLATFORM_STATE_BUCKET=bucket-de-estado
# PLATFORM_STATE_REGION=us-east-2
# PLATFORM_WORK_ROOT=/ruta/carpeta-persistente
# PLATFORM_AMI_FILE=/ruta/ami-ids.json
# PLATFORM_WEBHOOK_TOKEN=

# Configuración del adaptador y del asistente de P2.
# IAC_STATE_BUCKET=  # Solo Terraform/OpenTofu. CloudFormation administra el estado del stack.
# DEPLOYMENT_STATE_BUCKET es alias de IAC_STATE_BUCKET. Conserva el mismo bucket al reintentar.
# Por defecto estas rutas parten de la raíz del repositorio; al cambiarlas, usa rutas absolutas.
# IAC_BASE_OUTPUTS=.local/base.outputs.json
# IAC_AMI_IDS=infra/packer/ami-ids.json
# IAC_MODULE_DIR=infra/terraform/tenant
# IAC_CLOUD_INIT_TEMPLATE=infra/cloud-init/user-data.yaml.tftpl
# IAC_PLAN_PREVIEW=infra/terraform/plan_preview.py
# IAC_RUNS_DIR=.local/runs
# DEPLOYMENT_BASE_OUTPUTS_FILE, DEPLOYMENT_AMI_FILE y DEPLOYMENT_WORK_DIR son aliases de las rutas IAC_*.
# HEALTH_SCRIPT=/ruta/attendance-platform/infra/health/tenant-health.sh
# IAC_CFN_TEMPLATE=infra/cloudformation/tenant.yaml
# CFN_POLL_MS=10000
# Pulumi (P2, D3). El estado va en s3://<IAC_STATE_BUCKET>/pulumi; PULUMI_BACKEND_URL lo reemplaza.
# PULUMI_SECRETS_PROVIDER=passphrase  # o awskms://alias/<clave>?region=us-east-2
# PULUMI_CONFIG_PASSPHRASE=           # obligatoria con passphrase; no la subas al repositorio
# PULUMI_BIN=pulumi
# IAC_PULUMI_DIR=infra/pulumi/tenant  # requiere: pnpm --dir infra/pulumi/tenant install
# IAC_TIMEOUT_S=3600
# HEALTH_TIMEOUT_S=900
# TERRAFORM_BIN=terraform
# TOFU_BIN=tofu
# PYTHON_BIN=python

# Solo para pnpm admin:create. Completar la contraseña antes de ejecutarlo.
BOOTSTRAP_ADMIN_NAME=Administrador de plataforma
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
