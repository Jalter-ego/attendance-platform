{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "tenant-health",
      "folder": "Alertas de Attendance",
      "interval": "20s",
      "rules": [
        {
          "uid": "attendance-endpoint-down",
          "title": "Servicio sin respuesta",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 180,
                "to": 0
              },
              "datasourceUid": "attendance-prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "attendance-prometheus"
                },
                "expr": "1 - up{job=~\"node|attendance-core\",tenant!=\"\"}",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "type": "threshold",
                "refId": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "30s",
          "annotations": {
            "summary": "Endpoint de métricas caído"
          },
          "labels": {
            "severity": "critical"
          },
          "notification_settings": {
            "receiver": "Attendance API"
          }
        },
        {
          "uid": "attendance-backend-errors",
          "title": "Errores HTTP 5xx",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 180,
                "to": 0
              },
              "datasourceUid": "attendance-prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "attendance-prometheus"
                },
                "expr": "(sum by (tenant, env, role) (increase(http_requests_total{job=\"attendance-core\",status=~\"5..\"}[2m])) / clamp_min(sum by (tenant, env, role) (increase(http_requests_total{job=\"attendance-core\"}[2m])), 1) > bool 0.05) * (sum by (tenant, env, role) (increase(http_requests_total{job=\"attendance-core\"}[2m])) >= bool 10)",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "type": "threshold",
                "refId": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "30s",
          "annotations": {
            "summary": "Más del 5 % de respuestas 5xx en el backend"
          },
          "labels": {
            "severity": "critical"
          },
          "notification_settings": {
            "receiver": "Attendance API"
          }
        },
        {
          "uid": "attendance-cpu",
          "title": "Uso alto de CPU",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 180,
                "to": 0
              },
              "datasourceUid": "attendance-prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "attendance-prometheus"
                },
                "expr": "1 - avg by (tenant, env, role, instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[2m]))",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "type": "threshold",
                "refId": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.6
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "CPU por encima del 60 %"
          },
          "labels": {
            "severity": "warning"
          },
          "notification_settings": {
            "receiver": "Attendance API"
          }
        },
        {
          "uid": "attendance-memory",
          "title": "Uso alto de memoria",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 180,
                "to": 0
              },
              "datasourceUid": "attendance-prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "attendance-prometheus"
                },
                "expr": "1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"}",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "type": "threshold",
                "refId": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.8
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "Memoria por encima del 80 %"
          },
          "labels": {
            "severity": "warning"
          },
          "notification_settings": {
            "receiver": "Attendance API"
          }
        },
        {
          "uid": "attendance-disk",
          "title": "Espacio en disco",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 180,
                "to": 0
              },
              "datasourceUid": "attendance-prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "attendance-prometheus"
                },
                "expr": "1 - node_filesystem_avail_bytes{job=\"node\",mountpoint=~\"/|/var/lib/postgresql\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=~\"/|/var/lib/postgresql\"}",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "type": "threshold",
                "refId": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.85
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "Disco por encima del 85 %"
          },
          "labels": {
            "severity": "warning"
          },
          "notification_settings": {
            "receiver": "Attendance API"
          }
        }
      ]
    }
  ],
  "contactPoints": [
    {
      "orgId": 1,
      "name": "Attendance API",
      "receivers": [
        {
          "uid": "attendance-api",
          "type": "webhook",
          "disableResolveMessage": true,
          "settings": {
            "url": "$PLATFORM_ALERT_WEBHOOK_URL",
            "httpMethod": "POST",
            "authorization_scheme": "Bearer",
            "authorization_credentials": "$PLATFORM_WEBHOOK_TOKEN"
          }
        }
      ]
    }
  ]
}
